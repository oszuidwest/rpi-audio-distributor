[Unit]
Description=Audio Stream Player
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash -c '\
  source "$$HOME/.config/audio-distributor/config" && \
  exec /usr/bin/mpv \
    --no-video \
    --audio-device="$$AUDIO_DEVICE" \
    --volume="$$VOLUME" \
    $${AUDIO_FILTER:+--af="$$AUDIO_FILTER"} \
    --network-timeout=5 \
    --demuxer-readahead-secs=3 \
    --cache=yes \
    --cache-secs=3 \
    --input-ipc-server=/tmp/mpv-audio.sock \
    --idle=no \
    --user-agent="rpi-audio-distributor ($$(hostname))" \
    "$$STREAM_URL"'
Restart=always
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=default.target
